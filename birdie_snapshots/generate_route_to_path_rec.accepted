---
version: 1.5.2
title: generate_route_to_path_rec
file: ./test/roundabout/internal/generate_route_to_path_test.gleam
test_name: generate_route_to_path_rec_test
---
pub fn route_to_path(route: Route) -> String {
  case route {
    Home -> "/"
    Orders -> "/" <> "orders"
    Products(sub) -> "/" <> "products" <> products_route_to_path(sub)
    User(user_id, sub) ->
      "/" <> "users" <> "/" <> int.to_string(user_id) <> user_route_to_path(sub)
  }
}

fn products_route_to_path(route: ProductsRoute) -> String {
  case route {
    ProductsProduct(product_id) -> "/" <> int.to_string(product_id)
  }
}

fn user_route_to_path(route: UserRoute) -> String {
  case route {
    UserShow -> ""
    UserDelete -> "/" <> "delete"
  }
}


