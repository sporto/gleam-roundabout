---
version: 1.5.2
title: generate_helpers_rec
---
pub fn home_route() -> Route {
  Home
}

pub fn home_path() -> String {
  home_route() |> route_to_path
}

pub fn orders_route() -> Route {
  Orders
}

pub fn orders_path() -> String {
  orders_route() |> route_to_path
}

pub fn products_product_route(products_product_product_id: Int) -> Route {
  ProductsProduct(product_product_id) |> Products(_)
}

pub fn products_product_path(products_product_product_id: Int) -> String {
  products_product_route(products_product_product_id) |> route_to_path
}

pub fn user_show_route(user_user_id: Int) -> Route {
  UserShow |> User(user_user_id, _)
}

pub fn user_show_path(user_user_id: Int) -> String {
  user_show_route(user_user_id) |> route_to_path
}

pub fn user_delete_route(user_user_id: Int) -> Route {
  UserDelete |> User(user_user_id, _)
}

pub fn user_delete_path(user_user_id: Int) -> String {
  user_delete_route(user_user_id) |> route_to_path
}


